# Sift Environment Configuration
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control or expose credentials.

# Google Gemini API Key for Gemma 4 models (Required)
# Generate via Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Identifier (Optional - defaults to gemma-4-26b-a4b-it)
# Verified working models: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# GitHub Personal Access Token (Optional)
# Recommended for higher rate limits (60 req/hr unauthenticated vs 5000 req/hr authenticated).
# Only needs read permissions for public repositories.
GITHUB_TOKEN=
